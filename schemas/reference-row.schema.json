{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chimera:schema:reference-row:1",
  "title": "CHIMERA references.tsv logical row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "genome_id",
    "label",
    "accession_version",
    "release_date",
    "sequence_ids",
    "contig_count",
    "length_nt",
    "sha256",
    "source_input_ids",
    "taxonomy",
    "metadata_extra"
  ],
  "properties": {
    "genome_id": {"$ref": "#/$defs/stableId"},
    "label": {"enum": ["virus", "host"]},
    "accession_version": {"$ref": "#/$defs/optionalStableId"},
    "release_date": {"$ref": "#/$defs/optionalDate"},
    "sequence_ids": {
      "type": "string",
      "contentMediaType": "application/json",
      "contentSchema": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/stableId"}
      }
    },
    "contig_count": {"type": "integer", "minimum": 1},
    "length_nt": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_input_ids": {
      "type": "string",
      "contentMediaType": "application/json",
      "contentSchema": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "taxonomy": {
      "type": "string",
      "contentMediaType": "application/json",
      "contentSchema": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      }
    },
    "metadata_extra": {
      "type": "string",
      "contentMediaType": "application/json",
      "contentSchema": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,254}$"
    },
    "optionalStableId": {
      "oneOf": [
        {"const": ""},
        {"$ref": "#/$defs/stableId"}
      ]
    },
    "optionalDate": {
      "oneOf": [
        {"const": ""},
        {"type": "string", "format": "date"}
      ]
    }
  }
}
